{
  "name": "BuildSupply",
  "short_name": "BuildSupply",
  "description": "Billing and khata for building material suppliers",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A2427",
  "theme_color": "#0A2427",
  "lang": "en",
  "icons": [
    { "src": "/icon-192.png?v=3", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New bill",
      "short_name": "New bill",
      "description": "Start a new bill",
      "url": "/go/bill",
      "icons": [
        { "src": "/shortcut-bill-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/shortcut-bill-maskable-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Receive payment",
      "short_name": "Payment",
      "description": "Record money a customer paid",
      "url": "/go/payment",
      "icons": [
        { "src": "/shortcut-pay-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/shortcut-pay-maskable-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Send shop details",
      "short_name": "Shop details",
      "description": "Send your shop's details, order link and rates to a customer on WhatsApp",
      "url": "/go/details",
      "icons": [
        { "src": "/shortcut-send-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/shortcut-send-maskable-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    }
  ]
}
