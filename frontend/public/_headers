# Netlify / Cloudflare Pages response headers.

# The same security headers vercel.json sends, so moving host never drops
# them. The Content-Security-Policy (audit F-12) lets a page load code only
# from this site, and talk only to this app's Supabase project and the
# password breach check; pictures may also come from that project's storage.
# Keep the two files' policies identical.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://pefarymejlfdsmwusbbq.supabase.co; font-src 'self' data:; connect-src 'self' https://pefarymejlfdsmwusbbq.supabase.co wss://pefarymejlfdsmwusbbq.supabase.co https://api.pwnedpasswords.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The service worker decides which version of the app every installed phone
# runs, so it must never be served from a stale CDN copy — a cached sw.js can
# keep handing out an old build long after a deploy. Browsers already refuse
# to cache it for more than 24h; this makes it immediate.
/sw.js
  Cache-Control: no-cache

# Same reasoning for the shell and the manifest: they carry the references to
# the hashed asset filenames, so a stale copy points at files that no longer
# exist.
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Everything Vite emits under /assets/ is content-hashed, so the filename
# changes whenever the contents do and it can be cached hard, forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
